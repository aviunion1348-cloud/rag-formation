# ragformation configuration — copy to .env and export, or pass inline.
# Every value below has a working default; nothing here is required to start.
# This example is LOCAL-ONLY: loopback bind, no CORS, no cloud providers.
# NEVER commit real credentials.

# ---------------------------------------------------------------- storage
RAG_DATA_DIR=data
# RAG_DEFAULT_TENANT=local

# ------------------------------------------------------------- embeddings
# auto   : use Ollama if it is reachable, otherwise the local hashing fallback
# ollama : require Ollama (fails loudly if it is missing)
# hashing: deterministic lexical hashing (NOT semantic search)
# (an "openai" provider exists in code; it is intentionally not configured here)
RAG_EMBED_PROVIDER=auto
RAG_EMBED_MODEL=nomic-embed-text
# RAG_EMBED_DIMENSION=        # optional: assert the provider's vector size
RAG_EMBED_BATCH_SIZE=32
# 1 = refuse to start unless the embedder is semantic (no silent hashing fallback)
RAG_REQUIRE_SEMANTIC=0

# ------------------------------------------------------------- generation
# auto | ollama | extractive
RAG_LLM_PROVIDER=auto
RAG_LLM_MODEL=llama3.2:3b
RAG_TEMPERATURE=0.3
RAG_TOP_P=0.9
RAG_MAX_OUTPUT_TOKENS=512

# ---------------------------------------------------------------- retrieval
RAG_TOP_K=6
RAG_CANDIDATE_MULTIPLIER=4
RAG_RETRIEVAL_MODE=hybrid          # hybrid | semantic | lexical
RAG_RERANK=1
RAG_RRF_K=60
RAG_MMR_LAMBDA=0.72
RAG_MAX_CONTEXT_TOKENS=1400
RAG_ABSTAIN_THRESHOLD=0.24

# ----------------------------------------------------------------- chunking
RAG_CHUNK_TARGET_TOKENS=180
RAG_CHUNK_MAX_TOKENS=300
RAG_CHUNK_OVERLAP_TOKENS=40

# ----------------------------------------------------------------- network
# Keep Ollama on loopback. Do not point this at a remote host.
OLLAMA_HOST=http://127.0.0.1:11434
RAG_REQUEST_TIMEOUT_S=60
RAG_MAX_RETRIES=2

# ----------------------------------------------------------------- security
RAG_MAX_SOURCE_BYTES=8388608
# RAG_API_KEY=               # when set, /api requires x-api-key
RAG_ALLOW_PATH_INGEST=1
# Empty = no cross-origin access. Set an explicit origin only if you need one.
RAG_CORS_ORIGIN=
# Only behind a trusted reverse proxy that authenticates users:
RAG_TRUST_PROXY=0
# RAG_PRINCIPAL_HEADER=x-forwarded-user
# Never enable on a shared network: allows a non-loopback bind without auth.
RAG_ALLOW_INSECURE_PUBLIC=0
RAG_RATE_LIMIT_PER_MINUTE=600
RAG_MAX_CONCURRENT_QUERIES=8

# --------------------------------------------------------------------- http
RAG_HOST=127.0.0.1
RAG_PORT=8787

# ---------------------------------------------------------------- telemetry
RAG_PERSIST_TRACES=1
RAG_LOG_LEVEL=INFO

# ------------------------------------------------------------ lear agent
# `python -m ragformation lear ...` reads only these RAG_LEAR_* variables.
# backend=ollama is the qualifying configuration (local Ollama only, no cloud
# fallback). backend=baseline is hashing + extractive, offline, and every
# output it produces is labelled NOT qualifying.
RAG_LEAR_BACKEND=ollama
RAG_LEAR_OLLAMA_URL=http://127.0.0.1:11434
RAG_LEAR_EMBED_MODEL=nomic-embed-text
RAG_LEAR_LLM_MODEL=qwen2.5:1.5b
RAG_LEAR_JUDGE_MODEL=llama3.2:1b
RAG_LEAR_EMBED_MAX_PARAMS=200000000
RAG_LEAR_MODEL_MAX_PARAMS=4000000000
# RAG_LEAR_SOURCE=/path/to/lear-backend   # pinned checkout used by docs build/verify
RAG_LEAR_DATA_DIR=data/lear
RAG_LEAR_DOCS_DIR=docs/lear_backend
RAG_LEAR_TOP_K=6
RAG_LEAR_MAX_CONTEXT_TOKENS=1800
RAG_LEAR_MAX_OUTPUT_TOKENS=512
RAG_LEAR_TEMPERATURE=0.2
RAG_LEAR_TOP_P=0.9
# Unset = per-backend default: baseline 0.215 (calibrated on the calibration
# split), ollama 0.24 (engine default, not yet calibrated against Ollama).
# RAG_LEAR_ABSTAIN_THRESHOLD=0.24
RAG_LEAR_REQUEST_TIMEOUT_S=180
# Chunking (changing these re-chunks every document on the next index rebuild)
RAG_LEAR_CHUNK_TARGET_TOKENS=180
RAG_LEAR_CHUNK_MAX_TOKENS=300
RAG_LEAR_CHUNK_OVERLAP_TOKENS=20
RAG_LEAR_SESSION_TTL_S=604800
RAG_LEAR_HISTORY_TOKENS=900
RAG_LEAR_KEEP_RECENT_TURNS=4
RAG_LEAR_MEMORY_ITEMS=3
RAG_LEAR_RATE_USER_PER_MIN=30
RAG_LEAR_RATE_SESSION_PER_MIN=20
RAG_LEAR_MAX_CONCURRENT=2
RAG_LEAR_QUEUE_TIMEOUT_S=30
RAG_LEAR_MAX_INPUT_CHARS=2000
# Decline questions that name something the indexed docs never mention (1/0)
RAG_LEAR_SCOPE_GUARD=1
# ollama backend only: 1 = return the engine's extractive answer, labelled as a
# fallback, when the local LLM fails; 0 (default) = report an ERROR instead
RAG_LEAR_ALLOW_EXTRACTIVE_FALLBACK=0
