# ragformation configuration — copy to .env and export, or pass inline.
# Every value below has a working default; nothing here is required to start.
# NEVER commit real credentials.

# ---------------------------------------------------------------- storage
RAG_DATA_DIR=data

# ------------------------------------------------------------- embeddings
# auto  : use Ollama if it is reachable, otherwise the local hashing fallback
# ollama: require Ollama (fails loudly if it is missing)
# openai: any OpenAI-compatible /embeddings endpoint
# hashing: deterministic lexical hashing (NOT semantic search)
RAG_EMBED_PROVIDER=auto
RAG_EMBED_MODEL=nomic-embed-text
RAG_EMBED_BATCH_SIZE=32

# ------------------------------------------------------------- generation
# auto | ollama | openai | extractive
RAG_LLM_PROVIDER=auto
RAG_LLM_MODEL=llama3.2:3b
RAG_TEMPERATURE=0.3
RAG_TOP_P=0.9
RAG_MAX_OUTPUT_TOKENS=512

# ---------------------------------------------------------------- retrieval
RAG_TOP_K=6
RAG_RETRIEVAL_MODE=hybrid          # hybrid | semantic | lexical
RAG_RERANK=1
RAG_RRF_K=60
RAG_MMR_LAMBDA=0.72
RAG_MAX_CONTEXT_TOKENS=1400
RAG_ABSTAIN_THRESHOLD=0.22

# ----------------------------------------------------------------- chunking
RAG_CHUNK_TARGET_TOKENS=180
RAG_CHUNK_MAX_TOKENS=300
RAG_CHUNK_OVERLAP_TOKENS=40

# ----------------------------------------------------------------- network
OLLAMA_HOST=http://127.0.0.1:11434
# OPENAI_API_KEY=            # only needed for RAG_*_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
RAG_REQUEST_TIMEOUT_S=60
RAG_MAX_RETRIES=2

# ----------------------------------------------------------------- security
RAG_MAX_SOURCE_BYTES=8388608
# RAG_API_KEY=               # when set, /api requires x-api-key
RAG_ALLOW_PATH_INGEST=1
RAG_CORS_ORIGIN=*

# --------------------------------------------------------------------- http
RAG_HOST=0.0.0.0
RAG_PORT=8787

# ---------------------------------------------------------------- telemetry
RAG_PERSIST_TRACES=1
RAG_LOG_LEVEL=INFO
