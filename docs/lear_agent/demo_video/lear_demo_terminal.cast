[20.9341, "o", "\r\u001b[K  \u001b[36;1m[ LOOPBACK ONLY ]\u001b[0m model traffic may only reach the local Ollama on this machine\r\n  LIVE ············ measured or returned by this execution\r\n"]
[20.9696, "o", "  RECORDED ········ loaded from a checksum-verified recording (run id, capture time, commit)\r\n"]
[21.0048, "o", "  ILLUSTRATIVE ···· explanation or example only, never a measurement\r\n"]
[21.0401, "o", "  UNAVAILABLE ····· this capability or measurement cannot be observed here\r\n"]
[21.0754, "o", "  BLOCKED ········· a dependency, model or environment prerequisite is missing\r\n"]
[21.1106, "o", "  NOT QUALIFYING ·· a real result that does not meet the qualification conditions (baseline)\r\n"]
[21.1459, "o", "\u001b[33m  limitation: \u001b[0mQualification stays BLOCKED until a real local-model run passes doctor, evaluation and the judge.\r\n\u001b[90m  [Enter] next [p] auto [b] back [n] next [0-11] jump [r] replay [d/e] detail [m] models [?] help [q] quit\u001b[0m\r\n"]
[26.3696, "o", "  Enter or Space  continue to the next scene\r\n  p               pause or resume automatic advance (auto waits a few seconds per scene)\r\n  b or Left       previous scene (older versions used p for this; p now pauses/resumes)\r\n  n or Right      next scene\r\n"]
[26.3696, "o", "  0-9, then 0-1   jump to a scene: 4 -> S04; 1 then 1 quickly -> S11\r\n  r               show the recorded replay of this scene\r\n  d / e           re-show this scene in examiner detail (commands, sources, evidence)\r\n  m               show the model gate (S03)\r\n  q or Ctrl-C     quit (exit 130 for Ctrl-C); the terminal is always restored\r\n"]
[33.0805, "o", "\r.... ...  ............... ...........  ......\u001b[K"]
[33.1606, "o", "\r\u001b[K\u001b[1m┌─── S01  Source-of-truth archaeology  \u001b[0m\u001b[32;1m[LIVE]\u001b[0m\r\n"]
[33.1608, "o", "\u001b[35m┌─ CONCEPTUAL EXPLANATION (ILLUSTRATIVE) ──────────────────────────────────────────────────────────┐\u001b[0m\r\n"]
[33.1961, "o", "\u001b[35m│ Every claim in docs/lear_backend cites path:Lx-Ly at one pinned commit. The verifier re-reads    │\u001b[0m\r\n"]
[33.2314, "o", "\u001b[35m│ the checkout and fails on any stale or invalid reference. Generated pages are regenerated, never │\u001b[0m\r\n"]
