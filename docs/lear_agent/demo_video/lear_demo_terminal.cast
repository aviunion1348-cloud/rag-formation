[67.6268, "o", "\r\u001b[K\u001b[1m┌─── S05  Hybrid retrieval  \u001b[0m\u001b[32;1m[LIVE]\u001b[0m\r\n"]
[67.6268, "o", "\u001b[35m┌─ CONCEPTUAL EXPLANATION (ILLUSTRATIVE) ──────────────────────────────────────────────────────────┐\u001b[0m\r\n"]
[67.6622, "o", "\u001b[35m│ Dense and BM25 candidates are fused with RRF, re-ranked by a coverage heuristic and diversified  │\u001b[0m\r\n"]
[67.6974, "o", "\u001b[35m│ with MMR, then packed into the context budget between trusted instructions and delimited,        │\u001b[0m\r\n"]
[67.7327, "o", "\u001b[35m│ untrusted evidence. On the baseline the dense channel is feature hashing, not semantics.         │\u001b[0m\r\n"]
[67.7679, "o", "\u001b[35m└──────────────────────────────────────────────────────────────────────────────────────────────────┘\u001b[0m\r\n"]
[67.8031, "o", "  \u001b[35;1m[ILLUSTRATIVE]\u001b[0m chain: cosine + BM25 → Reciprocal Rank Fusion (k=60) → heuristic-coverage-v1 reranker → MMR → context\r\n  \u001b[32;1m[LIVE]\u001b[0m dense channel: feature-hash similarity (baseline, NOT semantic)\r\n  \u001b[32;1m[LIVE]\u001b[0m mode: hybrid\r\n  \u001b[32;1m[LIVE]\u001b[0m fingerprint: hashing:hashing-lexical-v1:d512:norm=l2:metric=cosine:pre=lower-token-v1:fpv=2\r\n"]
[67.8031, "o", "  \u001b[32;1m[LIVE]\u001b[0m candidates / selected: 10 / 10\r\n  \u001b[32;1m[LIVE]\u001b[0m context tokens: 1684\r\n  \u001b[32;1m[LIVE]\u001b[0m best support: 0.6515\r\n  \u001b[33;1m[UNAVAILABLE]\u001b[0m per-channel ranks (dense, BM25, RRF): UNAVAILABLE — CORE ENGINE DOES NOT EXPOSE THIS STAGE\r\n  \u001b[32;1m[LIVE]\u001b[0m context assembly: 10 chunks, manifest tokens 1684, engine estimate 1684 of budget 1800\r\n  candidates (filled = selected), bar = fused score:\r\n"]
