[3.4022, "o", "\u001b[35m┌─ CONCEPTUAL EXPLANATION (ILLUSTRATIVE) ──────────────────────────────────────────────────────────┐\u001b[0m\r\n"]
[3.4374, "o", "\u001b[35m│ Cold open: one real question about the Lear backend. It may be answered only from pinned Lear    │\u001b[0m\r\n"]
[3.4727, "o", "\u001b[35m│ documentation, and an answer counts only if every claim traces to a retrieved chunk and to Lear  │\u001b[0m\r\n"]
[3.5079, "o", "\u001b[35m│ source lines at one commit; without evidence the agent must abstain. The Lear repository is the  │\u001b[0m\r\n"]
[3.5432, "o", "\u001b[35m│ subject; RAG Formation is the instrument. Model traffic may only go to a loopback Ollama.        │\u001b[0m\r\n"]
[3.5784, "o", "\u001b[35m└──────────────────────────────────────────────────────────────────────────────────────────────────┘\u001b[0m\r\n"]
